#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""emailnews 启动器（安装到 /usr/bin/emailnews）

把安装目录 /opt/emailnews 加进 sys.path 后调用真正的入口，
这样 /usr/bin 下只需要一个很薄的壳，源码更新时不用重新生成启动器。
"""

import os
import sys

APP_DIR = "/opt/emailnews"
if os.path.isdir(APP_DIR) and APP_DIR not in sys.path:
    sys.path.insert(0, APP_DIR)

from emailnews.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
